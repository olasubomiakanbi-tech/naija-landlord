{
  // Cloudflare reads this file when it builds the Worker from GitHub.
  "name": "naija-landlord",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "routes": [{ "pattern": "naijalandlord.app/*", "zone_name": "naijalandlord.app" }],
  "kv_namespaces": [{ "binding": "NL_KV", "id": "ba1a3a46f8684e71822dce825efb619c" }],
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "observability": { "enabled": true }
}
